@startuml
title Secenek A - Monolit / Bilesen Diyagrami (#6 mimari analizi)
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "Misafir / Otel Personeli" as User

package "Hotel Management App\n(tek Java uygulamasi, tek deploy)" as App {
  [REST / UI Adapter] as API
  [Oda ve Oda Tipi Yonetimi] as Room
  [Misafir Yonetimi] as Guest
  [Rezervasyon ve Musaitlik] as Booking
  [Fiyatlandirma Kurallari] as Pricing
  [Check-in / Check-out] as Stay
  [Yaklasan Konaklama Zamanlayicisi] as Reminder
  [Odeme ve Bildirim Simulasyonu] as Sim
}

database "Hotel DB\n(tum tablolarin tek sahibi)" as DB

User --> API : HTTP - oda ara,\nrezervasyon / yonetim istegi
API --> Room : oda/tip/fiyat CRUD
API --> Guest : kayit ve gecmis
API --> Booking : tarihli arama,\nrezervasyon olustur/degistir/iptal
API --> Stay : check-in / check-out
Booking --> Room : oda durumu ve tipi
Booking --> Pricing : tutar hesapla
Booking --> Guest : misafir bilgisi
Booking --> Sim : odeme ve onay tetikle
Stay --> Booking : rezervasyon durumunu guncelle
Reminder --> Sim : yaklasan konaklama bildirimi
Room --> DB : SQL
Guest --> DB : SQL
Booking --> DB : SQL; tek transaction
Stay --> DB : SQL
Sim --> DB : simulasyon kaydi

@enduml
