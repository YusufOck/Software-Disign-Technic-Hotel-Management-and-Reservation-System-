@startuml
title Option A - Modular Monolith Component Diagram (Requirement 6)
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "Guest / Hotel Staff" as User
package "Hotel Management Application\n(one Java application, one deployment)" as App {
  [REST / UI Adapter] as API
  [Room and Room Type Management] as Room
  [Guest Management] as Guest
  [Reservation and Availability] as Booking
  [Pricing Rules] as Pricing
  [Check-in / Check-out] as Stay
  [Upcoming Stay Scheduler] as Reminder
  [Payment and Notification Simulation] as Sim
}
database "Hotel DB\n(single owner of all tables)" as DB

User --> API : HTTP search / booking / management
API --> Room : room, type and price management
API --> Guest : registration and history
API --> Booking : search / create / modify / cancel
API --> Stay : check-in / check-out
Booking --> Room : room status and type
Booking --> Pricing : calculate price
Booking --> Guest : guest data
Booking --> Sim : simulated payment and confirmation
Stay --> Booking : update reservation lifecycle
Reminder --> Sim : upcoming-stay notification
Room --> DB : SQL
Guest --> DB : SQL
Booking --> DB : SQL; one transaction
Stay --> DB : SQL
Sim --> DB : simulation record
@enduml
