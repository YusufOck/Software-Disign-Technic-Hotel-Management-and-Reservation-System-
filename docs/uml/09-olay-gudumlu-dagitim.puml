@startuml
title Secenek C - Olay Gudumlu CQRS + Saga / Dagitim Diyagrami (#6)
left to right direction
skinparam shadowing false

node "Istemci cihazi" as Client {
  artifact "Tarayici / Postman" as Browser
}

node "Dagitik konteyner ortami\n(ornek: Docker Compose)" as Host {
  node "api-gateway" as Gateway
  node "booking-command-saga" as Command
  node "availability-query-projector" as Query
  node "payment-worker" as Payment
  node "notification-worker" as Notify
  queue "event-broker\nRabbitMQ" as Broker
  database "booking-write-db" as WriteDB
  database "availability-read-db" as ReadDB
  database "payment-db" as PayDB
  database "notification-db" as NotifyDB
}

Browser --> Gateway : HTTP komut / sorgu
Gateway --> Command : HTTP rezervasyon komutu
Gateway --> Query : HTTP musaitlik sorgusu
Command --> WriteDB : SQL; hold/confirm,\natomik overlap denetimi
Command --> Broker : AMQP olay yayinla
Broker --> Payment : PaymentRequested
Payment --> PayDB : SQL; simule sonuc
Payment --> Broker : PaymentSucceeded/Failed
Broker --> Command : saga devam et
Broker --> Query : confirmed/cancelled olaylari
Query --> ReadDB : projection guncelle / oku
Broker --> Notify : bildirim olayi
Notify --> NotifyDB : SQL; teslim kaydi

@enduml
