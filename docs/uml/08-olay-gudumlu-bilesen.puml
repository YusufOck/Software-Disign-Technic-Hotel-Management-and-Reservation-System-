@startuml
title Secenek C - Olay Gudumlu CQRS + Saga / Bilesen Diyagrami (#6)
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "Misafir / Otel Personeli" as User
component "API Gateway" as Gateway
component "Rezervasyon Command + Saga\n(otorite, oda hold/confirm)" as Command
component "Musaitlik Query API + Projector\n(okuma modeli)" as Query
component "Odeme Worker\n(simule odeme)" as Payment
component "Bildirim Worker" as Notify
component "Event Broker\n(ReservationRequested,\nPaymentSucceeded/Failed,\nReservationConfirmed/Cancelled)" as Broker
database "Booking write DB\nhold + cakisma constraint" as WriteDB
database "Availability read DB\nprojection" as ReadDB
database "Payment DB" as PayDB
database "Notification DB" as NotifyDB

User --> Gateway : HTTP - komut ve sorgu
Gateway --> Command : POST/PUT/DELETE\nrezervasyon komutu
Gateway --> Query : GET tarihli musaitlik\nCQRS sorgusu
Command --> WriteDB : SQL; cakismayi otoriter denetle
Command --> Broker : ReservationRequested /\nPaymentRequested /\nReservationConfirmed/Cancelled
Broker --> Payment : PaymentRequested\nasenkron islem
Payment --> PayDB : odeme sonucunu kaydet
Payment --> Broker : PaymentSucceeded/Failed
Broker --> Command : odeme sonucu\nsaga confirm/release
Broker --> Query : rezervasyon olaylari\nread-model guncelle
Query --> ReadDB : projection yaz/oku
Broker --> Notify : onay / iptal olayi
Notify --> NotifyDB : bildirim kaydi

@enduml
