@startuml
title Create Reservation, Simulated Payment and Confirmation
autonumber
actor Guest
boundary ReservationController as Controller
control BookingFacade as Facade
control AvailabilityService as Availability
database RoomRepository as RoomRepo
database ReservationRepository as ReservationRepo
control PricingService as Pricing
entity RatePlan
participant PricingStrategy as Strategy
entity ChargeComponent as Charge
control PaymentService as Payment
participant PaymentGateway as Gateway
control ReservationEventPublisher as Publisher
participant GuestNotificationObserver as NotifyObserver
participant AuditObserver as Audit

Guest -> Controller: search(criteria)
Controller -> Facade: search(criteria)
Facade -> Availability: searchAvailable(criteria)
Availability -> RoomRepo: findAvailable(criteria)
RoomRepo --> Availability: candidateRooms
Availability -> ReservationRepo: findBlocking(candidateIds, period)
ReservationRepo --> Availability: blockingReservations
Availability --> Facade: availableRooms
Facade --> Controller: availableRooms
Controller --> Guest: show rooms

Guest -> Controller: create(command)
Controller -> Facade: createAndPay(command)
activate Facade

Facade -> Availability: lockRoomAndAssertNoOverlap(roomId, period)
Availability -> RoomRepo: findByIdForUpdate(roomId)
RoomRepo --> Availability: lockedRoom
Availability -> ReservationRepo: findBlocking(roomId, period)

alt overlap or room out of service
  ReservationRepo --> Availability: blocking reservation
  Availability --> Facade: ReservationConflict
  Facade --> Controller: 409 ROOM_NOT_AVAILABLE
  Controller --> Guest: choose another room/date
else room available
  ReservationRepo --> Availability: none
  Availability --> Facade: available

  Facade -> Pricing: quote(roomType, period, ratePlan, services)
  Pricing -> RatePlan: calculateBase(roomType, period)
  RatePlan -> Strategy: calculate(baseRate, period)
  Strategy --> RatePlan: baseAmount
  RatePlan --> Pricing: baseAmount
  Pricing -> Charge: new BaseStayCharge(baseAmount)

  loop each selected additional service
    Pricing -> Charge: wrap with matching decorator
  end

  Pricing -> Charge: total()
  Charge --> Pricing: quotedTotal and lines
  Pricing --> Facade: quote

  Facade -> ReservationRepo: save(PENDING_PAYMENT, quote snapshot)
  ReservationRepo --> Facade: reservation
  Facade -> Payment: charge(quotedTotal, paymentData)
  Payment -> Gateway: charge(quotedTotal, paymentData)

  alt payment approved
    Gateway --> Payment: approved(providerReference)
    Payment --> Facade: Payment(SUCCESS)
    Facade -> ReservationRepo: save(CONFIRMED)
    ReservationRepo --> Facade: confirmedReservation
    Facade -> Publisher: publish(ReservationCreated)
    par confirmation
      Publisher -> NotifyObserver: update(event)
    else audit
      Publisher -> Audit: update(event)
    end
    Facade --> Controller: 201 BookingConfirmation
    Controller --> Guest: confirmation and total
  else payment rejected
    Gateway --> Payment: declined
    Payment --> Facade: Payment(FAILED)
    Facade -> ReservationRepo: save(PAYMENT_FAILED)
    Facade --> Controller: 402 PAYMENT_FAILED
    Controller --> Guest: payment rejected
  end
end
deactivate Facade
@enduml

