@startuml
title Event-Driven Alternative - Component View
skinparam componentStyle rectangle
skinparam shadowing false
actor Client
component "Command API" as API
queue "Event Bus" as Bus
component "Availability Handler" as Availability
component "Pricing Handler" as Pricing
component "Reservation Handler" as Reservation
component "Payment Handler" as Payment
component "Room State Handler" as RoomState
component "Notification Handler" as Notification
component "Read Model Projector" as Projector
database "Event Store / Service State" as EventStore
database "Query Read Model" as ReadDB

Client --> API : ReservationRequested command
API --> Bus : ReservationRequested
Bus --> Availability : implicit invocation
Availability --> Bus : AvailabilityChecked
Bus --> Pricing : implicit invocation
Pricing --> Bus : PriceCalculated
Bus --> Reservation : implicit invocation
Reservation --> Bus : ReservationAccepted / Rejected
Bus --> Payment : implicit invocation
Payment --> Bus : PaymentCompleted / Failed
Bus --> RoomState : update room state
Bus --> Notification : create notification
Bus --> Projector : project all relevant events
Availability --> EventStore
Reservation --> EventStore
Payment --> EventStore
RoomState --> EventStore
Projector --> ReadDB
Client --> ReadDB : eventual query
@enduml

