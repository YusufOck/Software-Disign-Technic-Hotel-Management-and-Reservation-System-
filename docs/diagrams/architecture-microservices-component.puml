@startuml
title Microservices - Component View
skinparam componentStyle rectangle
skinparam shadowing false
actor Guest
actor "Hotel Staff" as Staff

component "Booking Service" as Booking {
  [Booking REST API] as BookingAPI
  [Booking Facade] as Facade
  [Pricing and Payment] as PricePay
  [Event Publisher] as Publisher
}
component "Inventory Service" as Inventory {
  [Inventory REST API] as InventoryAPI
  [Room Catalog] as Catalog
  [Availability and Allocation] as Allocation
}
component "Notification Service" as Notification {
  [Reservation Event Consumer] as Consumer
  [Notification Log API] as NotificationAPI
}
queue "RabbitMQ\nhotel.booking.events" as MQ
database "Booking DB" as BookingDB
database "Inventory DB" as InventoryDB
database "Notification DB" as NotificationDB

Guest --> BookingAPI : HTTP/JSON
Staff --> BookingAPI : HTTP/JSON
Staff --> InventoryAPI : HTTP/JSON
BookingAPI --> Facade : method call
Facade --> PricePay : method call
Facade --> InventoryAPI : REST hold/confirm/release
Facade --> BookingDB : JPA/JDBC
Publisher --> MQ : AMQP topic event
MQ --> Consumer : AMQP delivery
Consumer --> NotificationDB : JPA/JDBC
NotificationAPI --> NotificationDB : JPA/JDBC
Catalog --> InventoryDB : JPA/JDBC
Allocation --> InventoryDB : transaction + lock
@enduml

