@startuml
title Check-in and Check-out with Automatic Room Status
autonumber
actor "Hotel Staff" as Staff
boundary StayController as Controller
control StayService as Stay
database ReservationRepository as ReservationRepo
database RoomRepository as RoomRepo
entity Reservation
entity Room
control PaymentService as Payment
participant PaymentGateway as Gateway
control ReservationEventPublisher as Publisher
participant GuestNotificationObserver as Notification

group Check-in
  Staff -> Controller: checkIn(reservationId)
  Controller -> Stay: checkIn(reservationId)
  Stay -> ReservationRepo: findById(reservationId)
  ReservationRepo --> Stay: reservation

  alt status = CONFIRMED and date is valid
    Stay -> RoomRepo: findByIdForUpdate(roomId)
    RoomRepo --> Stay: room
    Stay -> Reservation: checkIn()
    Reservation --> Stay: status = CHECKED_IN
    Stay -> Room: markOccupied()
    Room --> Stay: status = OCCUPIED
    Stay -> ReservationRepo: save(reservation)
    Stay -> RoomRepo: save(room)
    Stay -> Publisher: publish(ReservationCheckedIn)
    Publisher -> Notification: update(event)
    Stay --> Controller: success
    Controller --> Staff: check-in completed
  else invalid status or date
    Stay --> Controller: 409 CHECK_IN_REJECTED
    Controller --> Staff: show reason
  end
end

... guest stay ...

group Check-out
  Staff -> Controller: checkOut(reservationId, paymentData)
  Controller -> Stay: checkOut(reservationId, paymentData)
  Stay -> ReservationRepo: findById(reservationId)
  ReservationRepo --> Stay: reservation

  alt status = CHECKED_IN
    opt outstandingBalance > 0
      Stay -> Payment: charge(outstandingBalance, paymentData)
      Payment -> Gateway: charge(outstandingBalance, paymentData)
      alt payment rejected
        Gateway --> Payment: declined
        Payment --> Stay: failed
        Stay --> Controller: 402 PAYMENT_REQUIRED
        Controller --> Staff: reservation remains CHECKED_IN
      else payment approved
        Gateway --> Payment: approved
        Payment --> Stay: success
      end
    end

    alt payment settled
      Stay -> RoomRepo: findByIdForUpdate(roomId)
      RoomRepo --> Stay: room
      Stay -> Reservation: complete()
      Reservation --> Stay: status = COMPLETED
      Stay -> Room: markCleaning()
      Room --> Stay: status = CLEANING
      Stay -> ReservationRepo: save(reservation)
      Stay -> RoomRepo: save(room)
      Stay -> Publisher: publish(ReservationCheckedOut)
      Publisher -> Notification: update(receiptEvent)
      Stay --> Controller: CheckoutReceipt
      Controller --> Staff: check-out completed
    end
  else status != CHECKED_IN
    Stay --> Controller: 409 CHECK_OUT_REJECTED
    Controller --> Staff: show reason
  end
end

opt housekeeping finishes
  Staff -> Controller: markRoomAvailable(roomId)
  Controller -> Stay: markRoomAvailable(roomId)
  Stay -> RoomRepo: findByIdForUpdate(roomId)
  RoomRepo --> Stay: room
  Stay -> Room: markAvailable()
  Stay -> RoomRepo: save(room)
end
@enduml

