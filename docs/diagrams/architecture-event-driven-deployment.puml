@startuml
title Event-Driven Alternative - Deployment View
skinparam shadowing false
node "Client Device" as Client
node "Container Platform" as Platform {
  node "command-api container" as API
  queue "event-broker cluster" as Broker
  node "availability worker" as Availability
  node "pricing worker" as Pricing
  node "reservation worker" as Reservation
  node "payment worker" as Payment
  node "room-state worker" as RoomState
  node "notification worker" as Notification
  node "read-model projector" as Projector
  database "event/service stores" as Stores
  database "query read model" as ReadDB
}

Client --> API : HTTPS command
API --> Broker : event
Broker --> Availability : event
Broker --> Pricing : event
Broker --> Reservation : event
Broker --> Payment : event
Broker --> RoomState : event
Broker --> Notification : event
Broker --> Projector : event stream
Availability --> Stores
Reservation --> Stores
Payment --> Stores
RoomState --> Stores
Projector --> ReadDB
Client --> API : query endpoint
API --> ReadDB : read
@enduml

