@startuml
title Microservices - Docker Compose Deployment View
skinparam shadowing false
node "User Device" as Client {
  artifact "Browser / Postman" as UI
}
node "Docker Host" as Host {
  node "booking-service container\n:8081" as Booking
  node "inventory-service container\n:8082" as Inventory
  node "notification-service container\n:8083" as Notification
  database "booking-db container\nPostgreSQL" as BookingDB
  database "inventory-db container\nPostgreSQL" as InventoryDB
  database "notification-db container\nPostgreSQL" as NotificationDB
  queue "rabbitmq container\nAMQP :5672 / UI :15672" as MQ
}

UI --> Booking : HTTP/JSON
UI --> Inventory : HTTP/JSON admin
UI --> Notification : HTTP/JSON evidence query
Booking --> Inventory : internal REST
Booking --> BookingDB : JDBC
Inventory --> InventoryDB : JDBC
Booking --> MQ : AMQP publish
MQ --> Notification : AMQP consume
Notification --> NotificationDB : JDBC
@enduml

